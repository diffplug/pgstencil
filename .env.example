# Copy to .env for optional local OAuth. Blank credentials keep providers disabled.
# Register the exact callbacks listed in examples/better-auth/README.md, on the
# origin `pnpm dev` prints for this PORT. Never commit real secrets.
PORT=8082
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
