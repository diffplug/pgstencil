{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pgstencil-auth-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "APP_ORIGIN": "https://replace-before-deploy.example",
    "EMAIL_FROM": "signin@replace-before-deploy.example",
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" },
  ],
}
