{
  "name": "pgstencil",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./database": "./src/database.ts",
    "./snapshots": "./src/snapshots.ts",
    "./testing": "./src/testing.ts",
    "./postgres": "./src/postgres.ts",
    "./diagnostics": "./src/diagnostics.ts"
  },
  "dependencies": {
    "pg": "^8.16.0",
    "node-pg-migrate": "^9.0.0",
    "testcontainers": "^12.1.0",
    "cheerio": "^1.1.0",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "kysely": "^0.29.5"
  },
  "devDependencies": {
    "kysely": "^0.29.5"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "migrations",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./database": {
        "types": "./dist/database.d.ts",
        "import": "./dist/database.js"
      },
      "./snapshots": {
        "types": "./dist/snapshots.d.ts",
        "import": "./dist/snapshots.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      },
      "./postgres": {
        "types": "./dist/postgres.d.ts",
        "import": "./dist/postgres.js"
      },
      "./diagnostics": {
        "types": "./dist/diagnostics.d.ts",
        "import": "./dist/diagnostics.js"
      }
    }
  },
  "description": "Postgres schema migrations, isolated test databases, and deterministic snapshot testing for TypeScript.",
  "license": "MIT",
  "homepage": "https://github.com/diffplug/pgstencil#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diffplug/pgstencil.git",
    "directory": "packages/pgstencil"
  },
  "bugs": {
    "url": "https://github.com/diffplug/pgstencil/issues"
  }
}
