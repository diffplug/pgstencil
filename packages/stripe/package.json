{
  "name": "@pgstencil/stripe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./migrations": "./src/migrations.ts"
  },
  "dependencies": {
    "pgstencil": "workspace:*",
    "kysely": "0.29.5",
    "stripe": "22.6.1"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      },
      "./migrations": {
        "types": "./dist/migrations.d.ts",
        "import": "./dist/migrations.js"
      }
    }
  }
}
